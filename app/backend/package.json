{
  "name": "ubinarys",
  "version": "4.1.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js --ignore public/",
    "production": "cross-env NODE_ENV=production node src/server.js",
    "setup": "node src/setup/setup.js",
    "setup:dev": "cross-env NODE_ENV=development ENABLE_DEFAULT_ADMIN=true node src/setup/setup.js",
    "upgrade": "node src/setup/upgrade.js",
    "db:reset-dangerous": "node src/setup/reset.js",
    "test": "node --test test/*.test.js",
    "audit:production": "npm audit --omit=dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "currency.js": "2.0.4",
    "dotenv": "16.3.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.4.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "glob": "^10.5.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "mongoose": "^8.24.4",
    "mongoose-autopopulate": "^1.2.1",
    "multer": "^1.4.4",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.4",
    "openai": "^4.27.0",
    "pug": "^3.0.3",
    "puppeteer": "^25.10.0",
    "resend": "^2.0.0",
    "transliteration": "^2.3.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "3.0.1"
  },
  "_moduleAliases": {
    "@": "src"
  },
  "main": "server.js",
  "author": "UBINARYS",
  "email": "hello@ubinarysapp.com",
  "license": "Fair-code License",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubinarys/ubinarys/.git"
  },
  "bugs": {
    "url": "https://github.com/ubinarys/ubinarys//issues"
  },
  "homepage": "https://github.com/ubinarys/ubinarys/#readme"
}
