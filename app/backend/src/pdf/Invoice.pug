doctype html
html
  head
    meta(name="viewport" content="width=device-width, initial-scale=1")
    style.
      @page {
        margin: 0;
        size: A4 portrait;
      }
      body {
        margin: 0;
        padding: 40px;
        font-family: Arial, sans-serif;
        font-size: 11px;
        color: #000;
      }
      .header-right {
        text-align: right;
        margin-bottom: 40px;
      }
      .header-right h1 {
        margin: 0;
        font-size: 20px;
        font-weight: bold;
      }
      .header-right p {
        margin: 2px 0;
      }
      .boxes-container {
        width: 100%;
        margin-bottom: 20px;
        overflow: hidden; /* clear floats */
      }
      .box-left {
        float: left;
        width: 48%;
      }
      .box-right {
        float: right;
        width: 48%;
      }
      .box-label {
        margin-bottom: 5px;
      }
      .box-content {
        padding: 15px;
        height: 100px;
      }
      .box-content.gray {
        background-color: #efefef;
      }
      .box-content.white {
        background-color: #ffffff;
        border: 1px solid #ccc;
      }
      .box-content p {
        margin: 2px 0;
      }
      .box-content p.strong {
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 5px;
      }
      .table-header {
        text-align: right;
        margin-bottom: 5px;
      }
      table.invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 5px;
      }
      table.invoice-table th, table.invoice-table td {
        border: 1px solid #ccc;
        padding: 8px;
        text-align: right;
        vertical-align: top;
      }
      table.invoice-table th {
        font-weight: normal;
        background-color: #fff;
      }
      table.invoice-table th.left, table.invoice-table td.left {
        text-align: left;
      }
      table.invoice-table td {
        /* Height removed to prevent page overflow */
      }
      .totals-container {
        width: 100%;
        overflow: hidden;
      }
      .totals {
        float: right;
        width: 40%;
      }
      .totals table {
        width: 100%;
        border-collapse: collapse;
      }
      .totals td {
        padding: 4px 8px;
        border: none;
      }
      .totals td.val {
        text-align: right;
      }
      .totals tr.ttc {
        background-color: #efefef;
        font-weight: bold;
      }
      .words {
        margin-top: 30px;
        font-size: 11px;
      }
      .words p {
        margin: 2px 0;
      }
      .words p.strong {
        font-weight: bold;
      }
      .footer {
        margin-top: 40px;
        text-align: center;
        font-size: 10px;
        border-top: 1px solid #eee;
        padding-top: 10px;
      }
      .footer p {
        margin: 2px 0;
      }
      .footer p.strong {
        font-weight: bold;
      }
  body
    .header-container(style="width: 100%; overflow: hidden; margin-bottom: 40px;")
      if settings.company_logo
        .header-left(style="float: left; width: 48%;")
          img.logo(src=settings.logoUrl alt="Logo" style="max-height:80px; max-width: 150px;")
      .header-right(style="float: right; width: 48%; margin-bottom: 0;")
        h1 Facture
        p Réf. : FV#{model.year || "26"}/#{model.number}
        p Date : #{moment(model.date).format(dateFormat || 'DD/MM/YYYY')}

    .boxes-container
      .box-left
        .box-label Émetteur :
        .box-content.gray
          p.strong #{settings.company_name}
          p #{settings.company_address}
          br
          p Tél. : #{settings.company_phone || ''}
          p I.C.E : #{settings.company_reg_number || ''}
      .box-right
        .box-label Adressé à :
        .box-content.white
          p.strong #{model.client.name}
          if model.client.company_reg_number || model.client.ice
             p I.C.E : #{model.client.company_reg_number || model.client.ice}
          else
             p I.C.E : ..................................

    .table-header Montants exprimés en MAD
    table.invoice-table
      thead
        tr
          th.left Désignation
          th TVA
          th P.U. HT
          th Qté
          th Total HT
      tbody
        tr
          td.left
            each item in model.items
              div(style="margin-bottom: 8px;") #{item.itemName}
          td
            each item in model.items
              div(style="margin-bottom: 8px;") #{model.taxRate}%
          td
            each item in model.items
              div(style="margin-bottom: 8px;") #{item.price}
          td
            each item in model.items
              div(style="margin-bottom: 8px;") #{item.quantity}
          td
            each item in model.items
              div(style="margin-bottom: 8px;") #{item.total}

    .totals-container
      .totals
        table
          tr
            td.left Total HT
            td.val #{model.subTotal}
          tr
            td.left Total TVA #{model.taxRate}%
            td.val #{model.taxTotal}
          tr.ttc
            td.left Total TTC
            td.val #{model.total}

    .words
      p Arrêtée la présente facture à la somme de :
      p.strong [Montant en toutes lettres à compléter]

    .footer
      p.strong Siège social : #{settings.company_address}
      p.strong Téléphone : #{settings.company_phone || ''}
      p.strong I.C.E : #{settings.company_reg_number || ''}
